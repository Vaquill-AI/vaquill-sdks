{
  "name": "@vaquill-ai/ai-sdk",
  "version": "0.1.0",
  "description": "Vaquill US primary law tools for the Vercel AI SDK: statutes, regulations, citations and session laws for generateText, streamText and agents.",
  "license": "MIT",
  "author": "Vaquill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaquill-AI/vaquill-sdks.git",
    "directory": "integrations/vercel-ai"
  },
  "homepage": "https://www.vaquill.ai/docs/api-guide/sdks/overview",
  "bugs": {
    "url": "https://github.com/Vaquill-AI/vaquill-sdks/issues"
  },
  "keywords": [
    "vaquill",
    "ai-sdk",
    "vercel-ai",
    "tools",
    "agents",
    "legal",
    "law",
    "statutes",
    "us-law",
    "citations"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run --coverage",
    "test:live": "VAQUILL_LIVE=1 vitest run --config vitest.live.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@vaquill-ai/sdk": "^0.2.0"
  },
  "peerDependencies": {
    "ai": "^5.0.15 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "ai": "^7.0.156",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
